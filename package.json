{
  "name": "comic-reader",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:site": "node --watch-path=site --watch-path=scripts --watch-path=locales.config.mjs scripts/build-site.mjs --serve",
    "build": "rm -rf dist && node scripts/i18n-check.mjs && vite build && node scripts/build-site.mjs",
    "build:dev": "DEPLOY_TARGET=dev npm run build",
    "build:app": "node scripts/i18n-check.mjs && vite build",
    "build:site": "node scripts/build-site.mjs",
    "preview": "node scripts/build-site.mjs --serve-only",
    "deploy": "./scripts/deploy.sh live",
    "deploy:dev": "./scripts/deploy.sh dev",
    "icons": "node scripts/generate-icons.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "pdfjs-dist": "^4.7.76",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "markdown-it": "^15.0.2",
    "sass": "^1.80.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
